GREYNOC_ENV=local
GREYNOC_DATABASE_PATH=data/threat_library/greynoc_detector_engine.sqlite
GREYNOC_DATA_DIR=data
GREYNOC_FIXTURE_ROOT=data/fixtures
GREYNOC_SOURCES_PATH=config/sources.yaml
GREYNOC_SCORING_PATH=config/scoring.yaml
GREYNOC_FETCH_LIVE=false
GREYNOC_GITHUB_TOKEN=
GREYNOC_API_KEY=
GREYNOC_LOG_LEVEL=INFO
GREYNOC_REQUEST_TIMEOUT_SECONDS=20
GREYNOC_HTTP_RETRIES=2
GREYNOC_MAX_RESPONSE_BYTES=5000000
