GREYNOC_ENV=local
GREYNOC_DATABASE_PATH=data/threat_library/greynoc_detector_engine.sqlite
GREYNOC_DATA_DIR=data
GREYNOC_FIXTURE_ROOT=data/fixtures
GREYNOC_SOURCES_PATH=config/sources.yaml
GREYNOC_SCORING_PATH=config/scoring.yaml
GREYNOC_FETCH_LIVE=false
GREYNOC_GITHUB_TOKEN=
GREYNOC_API_KEY=
GREYNOC_LOG_LEVEL=INFO
GREYNOC_REQUEST_TIMEOUT_SECONDS=20
GREYNOC_HTTP_RETRIES=2
GREYNOC_MAX_RESPONSE_BYTES=5000000
GREYNOC_ALLOW_INSECURE_HTTP=false
GREYNOC_BLOCK_PRIVATE_FETCH_HOSTS=true
# Shared secret for HMAC-SHA256 signing of detection / STIX export artifacts
# (quantum-resistant integrity baseline). Leave empty to disable signing.
# Public-key post-quantum signing (ML-DSA) is enabled via the 'pq' extras.
GREYNOC_SIGNING_HMAC_KEY=
# Optional comma-separated allowlist parsed by pydantic-settings for list[str] deployments.
# GREYNOC_ALLOWED_FETCH_HOSTS='["www.cisa.gov","services.nvd.nist.gov","api.github.com","api.first.org"]'
